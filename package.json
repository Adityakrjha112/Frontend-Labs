{
  "name": "frontend-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "import:questions": "tsx scripts/import-questions.ts",
    "predev": "npm run import:questions",
    "dev": "next dev",
    "prebuild": "npm run import:questions",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run import:questions && npm run lint && npm run typecheck && npm run test && npm run build",
    "report:mapping": "tsx scripts/report-mapping.ts",
    "emulators": "npx firebase-tools@15.35.0 emulators:start --only auth,database --project demo-frontend-lab",
    "deploy:rules": "npx firebase-tools@15.35.0 deploy --only database"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "firebase": "^13.2.0",
    "next": "^16.4.3",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
